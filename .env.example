# =============================================================================
# SANLE — exemplo de configuração. Copie para `.env.local` e preencha.
# NADA aqui é obrigatório: o app roda 100% sem chave (armazenamento local +
# IA determinística). Toda credencial é lida só no servidor.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dados públicos de contato/brand exibidos no site (NEXT_PUBLIC = vão ao browser).
NEXT_PUBLIC_SANLE_EMAIL=
NEXT_PUBLIC_SANLE_WHATSAPP=
NEXT_PUBLIC_SANLE_LINKEDIN=
NEXT_PUBLIC_SANLE_GITHUB=

# --- Supabase (opcional: sem isto, usa armazenamento local em disco) --------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Acesso ao painel -------------------------------------------------------
# Lista de e-mails autorizados (separada por vírgula).
SANLE_ADMIN_EMAILS=
# Dev local: libera o painel SEM Supabase. NUNCA usar em produção.
SANLE_LOCAL_ADMIN=false

# --- IA (opcional: sem isto há fallback determinístico) ---------------------
# provider: openai | anthropic | openai_compatible | local
SANLE_AI_PROVIDER=
SANLE_AI_API_KEY=
SANLE_AI_MODEL=gpt-4o-mini
SANLE_AI_BASE_URL=
SANLE_EMBED_MODEL=text-embedding-3-small

# --- IA: roteamento de modelo por finalidade (custo × qualidade) ------------
# Público/outreach usam o modelo econômico; admin (CRM) usa o de qualidade.
# Sem override, ambos caem em SANLE_AI_MODEL.
SANLE_AI_PUBLIC_MODEL=
SANLE_AI_ADMIN_MODEL=

# --- IA: governança de chamada (timeout/429/5xx são casos esperados) --------
SANLE_AI_MAX_OUTPUT_TOKENS=900
SANLE_AI_MAX_INPUT_CHARS=12000
SANLE_AI_TIMEOUT_MS=30000
# 0 desliga o retry (não recomendado). Backoff exponencial + jitter é o default.
SANLE_AI_MAX_RETRIES=2
SANLE_AI_TEMPERATURE=0.3
# Teto de custo diário em USD. 0 = sem teto (modo free-first/local).
SANLE_AI_DAILY_BUDGET_USD=0

# --- RAG / assistentes ------------------------------------------------------
# Liga o caminho vetorial (pgvector). "false" usa só a recuperação em memória.
SANLE_RAG_VECTOR=true
SANLE_RAG_TOP_K=5
SANLE_RAG_MIN_SCORE=0.06
SANLE_RAG_CONTEXT_MAX_CHARS=4500
# Kill-switch dos assistentes (sem deploy de código).
SANLE_AI_PUBLIC_CHAT=true
SANLE_AI_ADMIN_CHAT=true

# --- Prospecção: modo Free-First (default LIGADO) ---------------------------
# "false" desliga o Free-First. O default gratuito (OSM) nunca depende disto.
SANLE_PROSPECTING_FREE_FIRST=true
# Cache em memória das respostas de provedores (ms) e teto de entradas.
PROSPECT_CACHE_TTL_MS=900000
PROSPECT_CACHE_MAX=500
# Ritmo mínimo entre chamadas ao mesmo host. Nominatim exige >= 1,1 s.
PROSPECT_MIN_INTERVAL_MS=1100
# Timeout das chamadas HTTP externas (ms).
PROSPECT_HTTP_TIMEOUT_MS=25000

# --- OpenStreetMap (gratuito, sem chave — provedor DEFAULT) -----------------
OSM_ENABLED=true
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_NOMINATIM_ENABLED=true
# User-Agent identificável é EXIGÊNCIA das políticas OSM. Nunca genérico.
OSM_USER_AGENT=SanleProspecting/1.0 (contato@seudominio.com.br)
OSM_OVERPASS_TIMEOUT_SEC=25
OSM_MAX_PER_SEARCH=200

# --- Google Places (PAGO, OPCIONAL, desligado por default) ------------------
# Só roda com ENABLED=true E chave. Requer aprovação explícita do operador.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_RESULTS=20
GOOGLE_PLACES_MONTHLY_BUDGET_USD=0

# --- LinkedIn (opcional) ----------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
